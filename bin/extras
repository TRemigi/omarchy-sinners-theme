# --- bars ------------------------------------------------------------------------------------------------
#
# A bar is a plugin too, but it is chosen, not enabled: `omarchy bar use <id>` writes bar.id in shell.json, and `omarchy
# bar use omarchy.bar` goes back to the built-in. So the bar you had is remembered, as the font is, and put back.
#
# There are two bars, `bar` (sinners.bar, dark boards) and `bar-light` (sinners.bar-light, light boards). Either can be
# installed, and you can go from one to the other. What is remembered is the bar you had before either: it is saved only when
# the bar being replaced is not one of ours, and uninstall puts it back whichever of ours is in use.

OUR_BARS=("$BAR_ID" "$BAR_LIGHT_ID")

current_bar() { jq -r '.bar.id // "'"$BAR_DEFAULT"'"' "$SHELL_JSON" 2>/dev/null || echo "$BAR_DEFAULT"; }

# bar_check_id <bar id> <name for messages>
bar_check_id() {
  local id=$1
  command -v jq >/dev/null || fail "jq is needed to read which bar is in use"
  plugin_check "$id" Bar.qml BarModel.js WoodBoard.qml WornPaint.qml shaders/wear.frag.qsb wood/left-body.png wood/left-lcap.png wood/left-rcap.png \
    wood/center-body.png wood/center-lcap.png wood/center-rcap.png wood/right-body.png wood/right-lcap.png wood/right-rcap.png
  local pos
  pos=$(jq -r '.bar.position // "top"' "$SHELL_JSON" 2>/dev/null || echo top)
  if [[ $pos == left || $pos == right ]]; then
    echo "bar: note: your bar is on the $pos; the boards are only for a top or bottom bar, so it will look stock. omarchy bar position top" >&2
  fi
  return 0
}

bar_install_id() {
  local id=$1 previous
  previous=$(current_bar)
  mkdir -p "$PLUGINS_DIR"
  ln -sfn "$(plugin_src "$id")" "$(plugin_dst "$id")"
  echo "bar: $(plugin_dst "$id") -> $(plugin_src "$id")"
  if shell_running; then omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true; fi
  if [[ $previous == "$id" ]]; then
    echo "bar: $id is already the bar in use"
    return
  fi
  if omarchy bar use "$id" >/dev/null 2>&1; then
    # Remember the bar that was replaced, but only once the switch has worked, so a failure leaves no stale record, and only if it is
    # not one of ours: going from one of our bars to the other must not make the other the bar to go back to.
    if ! in_list "$previous" "${OUR_BARS[@]}"; then
      mkdir -p "$STATE_DIR"
      printf '%s\n' "$previous" >"$BAR_STATE"
      echo "bar: now using $id (was: $previous). If the bar looks unchanged, run: omarchy restart shell"
    else
      echo "bar: now using $id (was: $previous, one of ours; uninstall still goes back to the bar you had before). If the bar looks unchanged, run: omarchy restart shell"
    fi
  else
    echo "bar: linked, but could not switch to it; run: omarchy bar use $id" >&2
  fi
}

bar_uninstall_id() {
  local id=$1 dst previous current
  dst=$(plugin_dst "$id")
  current=$(current_bar)
  previous=$BAR_DEFAULT
  [[ -f $BAR_STATE ]] && previous=$(<"$BAR_STATE")
  if [[ $current == "$id" ]]; then
    # Switch away first: removing the link of the bar in use would leave the shell to fall back by itself.
    if [[ $previous == "$BAR_DEFAULT" ]] || in_list "$previous" "${OUR_BARS[@]}"; then
      omarchy bar reset >/dev/null 2>&1 || fail "could not switch back to the built-in bar; run: omarchy bar reset (nothing was removed)"
      echo "bar: back to the built-in bar"
    else
      omarchy bar use "$previous" >/dev/null 2>&1 || fail "could not switch back to $previous; run: omarchy bar use $previous (nothing was removed)"
      echo "bar: back to $previous"
    fi
    rm -f "$BAR_STATE"                                  # the bar you had has been put back, so there is nothing left to remember
  else
    echo "bar: the bar in use is $current, not $id; not switching"
  fi
  if plugin_is_ours "$id"; then
    rm "$dst"
    if shell_running; then omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true; fi
    echo "bar: removed $dst"
  elif [[ -e $dst || -L $dst ]]; then
    echo "bar: $dst is not this theme's link; left alone"
  else
    echo "bar: $id is not installed"
  fi
}

bar_status_id() {
  local id=$1 current
  if plugin_is_ours "$id"; then
    current=$(current_bar)
    if [[ $current == "$id" ]]; then
      echo "bar: $id linked and in use ($(plugin_dst "$id"))"
      [[ -f $BAR_STATE ]] && echo "        uninstall switches back to $(<"$BAR_STATE")"
    else
      echo "bar: $id linked, but the bar in use is $current; run: omarchy bar use $id"
    fi
  elif [[ -e $(plugin_dst "$id") || -L $(plugin_dst "$id") ]]; then
    echo "bar: $(plugin_dst "$id") exists but is not this theme's link"
  else
    echo "bar: $id is not installed"
  fi
}

bar_check()      { bar_check_id "$BAR_ID"; }
bar_install()    { bar_install_id "$BAR_ID"; }
bar_uninstall()  { bar_uninstall_id "$BAR_ID"; }
bar_status()     { bar_status_id "$BAR_ID"; }

bar_light_check()      { bar_check_id "$BAR_LIGHT_ID"; }
bar_light_install()    { bar_install_id "$BAR_LIGHT_ID"; }
bar_light_uninstall()  { bar_uninstall_id "$BAR_LIGHT_ID"; }
bar_light_status()     { bar_status_id "$BAR_LIGHT_ID"; }

# --- settings --------------------------------------------------------------------------------------------
#
# The settings panel: a bar widget that goes in the tray's drawer. It adds to the bar and replaces nothing. It does its work through
# plugins/sinners.settings/bin/sinners-settings, which needs jq.

settings_check() {
  plugin_check sinners.settings Panel.qml PanelBody.qml PluginCard.qml SettingRow.qml SettingsState.qml GuitarIcon.qml Catalog.js bin/sinners-settings
  command -v jq >/dev/null || fail "jq is needed by the settings panel"
  [[ -x $(plugin_src sinners.settings)/bin/sinners-settings ]] || fail "plugins/sinners.settings/bin/sinners-settings is not executable"
  return 0
}
settings_install() {
  plugin_install settings sinners.settings "The guitar is in the bar's tray drawer; hover the chevron at the right of the bar. If it is not there, run: omarchy restart shell" --section tray
}
settings_uninstall() { plugin_uninstall settings sinners.settings ""; }
settings_status()    { plugin_status settings sinners.settings; }

# --- dispatch --------------------------------------------------------------------------------------------

run_all() {
  local action=$1 extra
  shift
  ACTION=$action
  select_extras "$@"
  if [[ $action == install ]]; then
    for extra in "${SELECTED[@]}"; do "${extra//-/_}_check"; done   # every check first, so a refusal changes nothing
  fi
  for extra in "${SELECTED[@]}"; do "${extra//-/_}_$action"; done
  if (( REAPPLY )); then
    echo "applying Sinners again, so Omarchy's own Lua files are back"
    omarchy theme set sinners >/dev/null 2>&1 || echo "could not apply the theme again; run: omarchy theme set sinners" >&2
  fi
}

case "${1:-}" in
  install | uninstall | status) action=$1; shift; run_all "$action" "$@" ;;
  -h | --help | help | "")      usage ;;
  *)                            usage >&2; exit 1 ;;
esac
