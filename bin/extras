#!/bin/bash
# Installs the extras that go with the Sinners theme. With no names it does all of them.
#
#   bin/extras install [extra...]     install the named extras, or every extra
#   bin/extras uninstall [extra...]   undo the named extras, or every extra
#   bin/extras status [extra...]      show what is installed
#
# Extras (always handled in this order):
#   command   symlink ~/.local/bin/omarchy-sinners-unlock, the unlock screen picker
#   menu      add Appearance > Sinners Unlock to the Omarchy menu (shown only while Sinners is the active theme)
#   font      switch the system monospace font to iA Writer Mono S, remembering the font it replaces
#   embers    link the Embers shell plugin (plugins/sinners.embers) into ~/.config/omarchy/plugins and enable it
#
# One more extra is not in "every extra", and has to be named: it replaces something rather than adding to it.
#   toasts    link the Sinners Notifications plugin (plugins/sinners.notifications), which burns toasts away into
#             ash, and enable it. It is Omarchy's own notification daemon, copied and patched, and it takes the
#             built-in's place while enabled.
#
# What each one changes, and what uninstall undoes:
#   command   the symlink in ~/.local/bin
#   menu      one marked block in ~/.config/omarchy/extensions/omarchy-menu.jsonc, backed up before every change
#   font      the system font, through `omarchy font set`; uninstall puts the previous font back, but only if
#             the font is still iA Writer Mono S. If the font is missing, install adds its package
#             (ttf-ia-writer) with `omarchy pkg add`, which asks for sudo. Uninstall never removes a package.
#   embers    a symlink in ~/.config/omarchy/plugins, and the plugin's entry in shell.json, through
#             `omarchy plugin enable`. If the shell is not running, the link is made and the enable is left for
#             you to run. Uninstall disables the plugin and removes the link; its settings stay in shell.json.
#   toasts    the same, for plugins/sinners.notifications. It refuses while another plugin that replaces the
#             notification daemon (such as annihilation.notifications) is enabled: two cannot both be the daemon.
#             Uninstall disables it and removes the link, and Omarchy's own daemon is back.
#
# Every check for every selected extra runs before anything is changed, so a refusal leaves your system as it was.
#
# For testing, SINNERS_LOCAL_BIN, SINNERS_USER_MENU, SINNERS_STATE_DIR, SINNERS_PLUGINS_DIR and SINNERS_SHELL_JSON
# override the five locations.
set -euo pipefail

THEME_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
COMMAND=omarchy-sinners-unlock
LOCAL_BIN=${SINNERS_LOCAL_BIN:-$HOME/.local/bin}
USER_MENU=${SINNERS_USER_MENU:-$HOME/.config/omarchy/extensions/omarchy-menu.jsonc}
STATE_DIR=${SINNERS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-sinners-theme}
PLUGINS_DIR=${SINNERS_PLUGINS_DIR:-$HOME/.config/omarchy/plugins}
SHELL_JSON=${SINNERS_SHELL_JSON:-$HOME/.config/omarchy/shell.json}
FONT_NAME="iA Writer Mono S"
FONT_PACKAGE=ttf-ia-writer
FONT_STATE=$STATE_DIR/previous-font
EXTRAS=(command menu font embers)   # what a bare `install` does
OPT_IN=(toasts)                       # only when named

fail() { echo "install: $*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: bin/extras install [extra...]     install the named extras, or every extra
       bin/extras uninstall [extra...]   undo the named extras, or every extra
       bin/extras status [extra...]      show what is installed

Extras:
  command   symlink ~/.local/bin/omarchy-sinners-unlock, the unlock screen picker
  menu      add Appearance > Sinners Unlock to the Omarchy menu
  font      switch the system monospace font to iA Writer Mono S (uninstall restores the previous font)
  embers    add the Embers shell plugin: sparks that climb past the sun on the wallpaper

Not part of "every extra"; name it to use it:
  toasts    replace Omarchy's notification daemon with a copy that burns toasts away into ash

With no extras named, every extra above the blank line is used. Checks for all of them run before anything is changed.
USAGE
}

# in_list <item> <list...>: succeeds when item is one of the list. Plain loop, not grep -q, so pipefail cannot misfire.
in_list() {
  local wanted=$1 item
  shift
  for item in "$@"; do
    [[ $item == "$wanted" ]] && return 0
  done
  return 1
}

# Sets SELECTED to the named extras in the fixed EXTRAS order, or to all of them when none are named.
select_extras() {
  local name extra
  SELECTED=()
  if (( $# == 0 )); then
    SELECTED=("${EXTRAS[@]}")
    return
  fi
  for name in "$@"; do
    in_list "$name" "${EXTRAS[@]}" "${OPT_IN[@]}" || fail "unknown extra '$name' (have: ${EXTRAS[*]} ${OPT_IN[*]})"
  done
  for extra in "${EXTRAS[@]}" "${OPT_IN[@]}"; do
    in_list "$extra" "$@" && SELECTED+=("$extra")
  done
  return 0
}

menu_edit() {
  python3 -I - "$1" "$USER_MENU" <<'PY'
import json, os, re, shutil, sys, time

mode, path = sys.argv[1], sys.argv[2]
BEGIN_PREFIX = "// >>> sinners-theme unlock switcher"   # a block is found by this prefix, whatever follows it
BEGIN = "  " + BEGIN_PREFIX + " (managed by the theme's bin/extras; remove with: bin/extras uninstall)"
END = "  // <<< sinners-theme unlock switcher"
KEY = "appearance.sinners-unlock"
ENTRY = {
    "icon": "\U000F07F5",   # the same glyph as Appearance > Unlock
    "label": "Sinners Unlock",
    "aliases": ["sinners unlock"],
    "description": "Choose among this theme's unlock screens",
    "when": "[[ $(omarchy-theme-current) == Sinners ]]",
    "action": "\"$(omarchy-theme-dir sinners)/bin/omarchy-sinners-unlock\"",
}


def strip(raw):  # mirrors MenuModel.stripJsonc in the Omarchy shell
    raw = re.sub(r"^\s*//[^\n]*(\n|$)", "", raw, flags=re.M)
    return re.sub(r",(\s*[}\]])", r"\1", raw)


def parses(text):
    try:
        json.loads(strip(text))
        return True
    except ValueError:
        return False


def without_block(lines):
    out, skipping = [], False
    for line in lines:
        if line.strip().startswith(BEGIN_PREFIX):
            skipping = True
        elif skipping and line.strip() == END.strip():
            skipping = False
        elif not skipping:
            out.append(line)
    return out


existed = os.path.exists(path)
text = open(path, encoding="utf-8").read() if existed else "{\n}\n"
lines = text.split("\n")
has_block = any(l.strip().startswith(BEGIN_PREFIX) for l in lines)

if mode == "check":
    state = "present" if has_block else "absent"
    print(f"{state}{'' if parses(text) else ' (file does not parse as Omarchy menu JSONC)'}")
    sys.exit(0)

base = without_block(lines)
if not parses("\n".join(base)):
    sys.exit(f"{path} does not parse as Omarchy menu JSONC even without this block; fix it first, nothing was changed")

if mode in ("add", "verify"):
    closers = [i for i, l in enumerate(base) if l.strip() == "}"]
    if not closers:
        sys.exit(f"no closing }} found in {path}; nothing was changed")
    if mode == "verify":
        sys.exit(0)   # the file can take the block; write nothing
    close = closers[-1]
    j = close - 1
    while j >= 0 and (base[j].strip() == "" or base[j].lstrip().startswith("//")):
        j -= 1
    if j >= 0 and not base[j].rstrip().endswith(("{", ",")):
        base[j] = base[j].rstrip() + ","
    entry = "  " + json.dumps(KEY) + ": " + json.dumps(ENTRY, ensure_ascii=False) + ","
    base[close:close] = [BEGIN, entry, END]
elif mode != "remove":
    sys.exit(f"unknown mode {mode}")
elif not has_block:
    print("menu: not present")
    sys.exit(0)

new = "\n".join(base)
if not parses(new):
    sys.exit("the edited menu file would not parse; nothing was changed")
if existed and new == text:
    print("menu: already up to date")
    sys.exit(0)

if existed:
    shutil.copy2(path, f"{path}.bak.{int(time.time())}")
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".tmp"
open(tmp, "w", encoding="utf-8").write(new)
os.replace(tmp, path)
print(f"menu: {'added to' if mode == 'add' else 'removed from'} {path}")
PY
}


# --- command ---------------------------------------------------------------------------------------------

command_is_ours() { [[ -L $LOCAL_BIN/$COMMAND && $(readlink -f "$LOCAL_BIN/$COMMAND") == "$THEME_DIR/bin/$COMMAND" ]]; }

command_check() {
  local target=$LOCAL_BIN/$COMMAND
  if [[ -e $target && ! -L $target ]]; then
    fail "$target exists and is not a symlink; not touching it"
  fi
}

command_install() {
  mkdir -p "$LOCAL_BIN"
  ln -sfn "$THEME_DIR/bin/$COMMAND" "$LOCAL_BIN/$COMMAND"
  echo "command: $LOCAL_BIN/$COMMAND -> $THEME_DIR/bin/$COMMAND"
}

command_uninstall() {
  local target=$LOCAL_BIN/$COMMAND
  if command_is_ours; then
    rm "$target"
    echo "command: removed $target"
  elif [[ -e $target || -L $target ]]; then
    echo "command: $target is not this theme's link; left alone"
  else
    echo "command: not installed"
  fi
}

command_status() {
  local target=$LOCAL_BIN/$COMMAND
  if command_is_ours; then
    echo "command: installed ($target)"
  elif [[ -e $target || -L $target ]]; then
    echo "command: $target exists but is not this theme's link"
  else
    echo "command: not installed"
  fi
}

# --- menu ------------------------------------------------------------------------------------------------

menu_check()     { menu_edit verify; }
menu_install()   { menu_edit add; }
menu_uninstall() { menu_edit remove; }
menu_status()    { echo "menu: $(menu_edit check)"; }

# --- font ------------------------------------------------------------------------------------------------

# The same test omarchy-font-set uses before it will switch to a font.
font_present() { fc-list | grep -Fqi -- "$FONT_NAME"; }

font_check() {
  command -v omarchy >/dev/null || fail "omarchy not found on PATH; cannot set the font"
  if ! font_present && ! pacman -Si "$FONT_PACKAGE" >/dev/null 2>&1; then
    fail "$FONT_NAME is not installed and $FONT_PACKAGE is not in your package repositories"
  fi
}

font_install() {
  local current
  current=$(omarchy font current)
  if [[ $current == "$FONT_NAME" ]]; then
    echo "font: already $FONT_NAME"
    return
  fi
  if ! font_present; then
    echo "font: installing $FONT_PACKAGE (asks for sudo)"
    omarchy pkg add "$FONT_PACKAGE"
  fi
  omarchy font set "$FONT_NAME" || fail "omarchy could not switch to $FONT_NAME; the font was not changed"
  # Remember the font that was replaced, but only once the switch has worked, so a failure leaves no stale record.
  # This point is reached only when the font actually changed, so installing twice never overwrites the saved
  # font with iA Writer Mono S itself.
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$current" >"$FONT_STATE"
  echo "font: $FONT_NAME (was: $current); restart open terminals to see it"
}

font_uninstall() {
  local previous current
  if [[ ! -f $FONT_STATE ]]; then
    echo "font: nothing to restore"
    return
  fi
  previous=$(<"$FONT_STATE")
  current=$(omarchy font current)
  if [[ $current == "$FONT_NAME" ]]; then
    omarchy font set "$previous" || fail "could not restore '$previous'; it is saved in $FONT_STATE"
    rm -f "$FONT_STATE"
    echo "font: restored $previous"
  else
    rm -f "$FONT_STATE"
    echo "font: current font is $current, not $FONT_NAME; left alone"
  fi
}

font_status() {
  local current previous=""
  current=$(omarchy font current)
  [[ -f $FONT_STATE ]] && previous=$(<"$FONT_STATE")
  if [[ $current == "$FONT_NAME" ]]; then
    echo "font: $FONT_NAME is active${previous:+ (uninstall restores $previous)}"
  elif font_present; then
    echo "font: not active (current: $current; $FONT_NAME is installed)"
  else
    echo "font: not active (current: $current; $FONT_NAME is not installed, install would add $FONT_PACKAGE)"
  fi
}

# --- plugins: embers, toasts -----------------------------------------------------------------------------
#
# Both are shell plugins in this repo, linked into ~/.config/omarchy/plugins rather than copied, and enabled
# through Omarchy's own `omarchy plugin enable`.

shell_running() { [[ $(timeout 2 omarchy-shell shell ping 2>/dev/null) == ok ]]; }

# plugin_src <id>, plugin_dst <id>
plugin_src() { echo "$THEME_DIR/plugins/$1"; }
plugin_dst() { echo "$PLUGINS_DIR/$1"; }
plugin_is_ours() { [[ -L $(plugin_dst "$1") && $(readlink -f "$(plugin_dst "$1")") == "$(plugin_src "$1")" ]]; }

# plugin_check <id> <file the plugin cannot work without>...
plugin_check() {
  local id=$1 src dst needed
  shift
  src=$(plugin_src "$id"); dst=$(plugin_dst "$id")
  for needed in manifest.json "$@"; do
    [[ -f $src/$needed ]] || fail "$src is incomplete (missing $needed; plugins/$id/build-shaders.sh makes the .qsb files)"
  done
  if [[ -e $dst || -L $dst ]] && ! plugin_is_ours "$id"; then
    fail "$dst exists and is not this theme's link; not touching it"
  fi
  return 0
}

# plugin_install <name> <id> <what it does when enabled>
plugin_install() {
  local name=$1 id=$2 note=$3
  mkdir -p "$PLUGINS_DIR"
  ln -sfn "$(plugin_src "$id")" "$(plugin_dst "$id")"
  echo "$name: $(plugin_dst "$id") -> $(plugin_src "$id")"
  if shell_running; then
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    if omarchy plugin enable "$id" >/dev/null 2>&1; then
      echo "$name: enabled. $note"
    else
      echo "$name: linked, but could not enable it; run: omarchy plugin enable $id" >&2
    fi
  else
    echo "$name: the shell is not running; after login run: omarchy plugin enable $id"
  fi
}

# plugin_uninstall <name> <id> <what goes back>
plugin_uninstall() {
  local name=$1 id=$2 back=$3 dst
  dst=$(plugin_dst "$id")
  if plugin_is_ours "$id"; then
    if shell_running; then omarchy plugin disable "$id" >/dev/null 2>&1 || true; fi
    rm "$dst"
    if shell_running; then omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true; fi
    echo "$name: disabled and removed $dst (its settings stay in shell.json)${back:+. $back}"
  elif [[ -e $dst || -L $dst ]]; then
    echo "$name: $dst is not this theme's link; left alone"
  else
    echo "$name: not installed"
  fi
}

# plugin_status <name> <id>
plugin_status() {
  local name=$1 id=$2 dst
  dst=$(plugin_dst "$id")
  if plugin_is_ours "$id"; then
    echo "$name: linked ($dst)"
    if shell_running; then
      echo "        $(omarchy plugin list 2>/dev/null | grep -F "$id" | head -1 | sed 's/^ *//' || true)"
    else
      echo "        the shell is not running, so whether it is enabled cannot be checked"
    fi
  elif [[ -e $dst || -L $dst ]]; then
    echo "$name: $dst exists but is not this theme's link"
  else
    echo "$name: not installed"
  fi
}

embers_check()     { plugin_check sinners.embers shaders/embers.frag.qsb shaders/smoke.frag.qsb; }
embers_install()   { plugin_install embers sinners.embers "They show while Sinners is the active theme."; }
embers_uninstall() { plugin_uninstall embers sinners.embers ""; }
embers_status()    { plugin_status embers sinners.embers; }

# The other plugins in the plugins directory that replace the notification daemon and are enabled in shell.json
# (one id per line). Two cannot both be the daemon, and which Omarchy would pick is not defined.
other_notification_clones() {
  local manifest id
  [[ -d $PLUGINS_DIR && -f $SHELL_JSON ]] || return 0
  for manifest in "$PLUGINS_DIR"/*/manifest.json; do
    [[ -f $manifest ]] || continue
    id=$(jq -r 'select(.omarchy.clonedFrom == "omarchy.notifications") | .id // empty' "$manifest" 2>/dev/null) || continue
    [[ -n $id && $id != sinners.notifications ]] || continue
    # enabled = listed in plugins[] (a plain id or an object with an id) and not in disabledPlugins
    if jq -e --arg id "$id" '((.plugins // []) | map(if type == "object" then .id else . end) | index($id)) != null
                              and (((.disabledPlugins // []) | index($id)) == null)' "$SHELL_JSON" >/dev/null 2>&1; then
      echo "$id"
    fi
  done
}

toasts_check() {
  plugin_check sinners.notifications shaders/burn.frag.qsb shaders/ash.frag.qsb Service.qml Toast.qml Burn.qml
  command -v jq >/dev/null || fail "jq is needed to check for another notification daemon plugin"
  local other
  other=$(other_notification_clones)
  if [[ -n $other ]]; then
    fail "$(echo $other) already replaces Omarchy's notification daemon, and two cannot both be it. Disable it first (omarchy plugin disable $(echo $other | cut -d' ' -f1)), then run this again."
  fi
  # A copy of Omarchy's daemon that has fallen behind Omarchy is worth a word; it is not a reason to refuse.
  "$THEME_DIR/tools/check-notifications-upstream.sh" >/dev/null 2>&1 ||
    echo "toasts: note: the copy of Omarchy's notification plugin no longer matches the installed one; run tools/check-notifications-upstream.sh" >&2
  return 0
}
toasts_install() {
  plugin_install toasts sinners.notifications "It is now the notification daemon; toasts burn away while Sinners is the active theme. If notifications look unchanged, run: omarchy restart shell"
}
toasts_uninstall() { plugin_uninstall toasts sinners.notifications "Omarchy's own notification daemon is back; if it does not return at once, run: omarchy restart shell"; }
toasts_status()    { plugin_status toasts sinners.notifications; }

# --- dispatch --------------------------------------------------------------------------------------------

run_all() {
  local action=$1 extra
  shift
  select_extras "$@"
  if [[ $action == install ]]; then
    for extra in "${SELECTED[@]}"; do "${extra}_check"; done   # every check first, so a refusal changes nothing
  fi
  for extra in "${SELECTED[@]}"; do "${extra}_$action"; done
}

case "${1:-}" in
  install | uninstall | status) action=$1; shift; run_all "$action" "$@" ;;
  -h | --help | help | "")      usage ;;
  *)                            usage >&2; exit 1 ;;
esac
